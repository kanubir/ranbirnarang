---
// Resume page: displays src/data/resume.ts. All content lives in that file; this page is only layout.
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config';
import { resume } from '../data/resume';
import { formatYearMonth } from '../lib/format';
---

<BaseLayout
  title="Resume"
  description="Resume of Ranbir Singh Narang: technical lead with 10+ years of experience in backend and distributed systems, cloud, and AI."
>
  <article class="resume">
    <header class="resume-header">
      <h1>{SITE.name}</h1>
      <p class="muted">{SITE.role} · {resume.location}</p>
      {/* The PDF is printed from this page (see @media print below), so both always match. */}
      <p class="resume-actions">
        <a class="button" href="/resume.pdf" download="Ranbir-Singh-Narang-Resume.pdf">
          Download PDF
        </a>
      </p>
    </header>

    <section aria-labelledby="summary-heading">
      <h2 id="summary-heading">Summary</h2>
      <ul class="summary">
        {resume.summary.map((point) => <li>{point}</li>)}
      </ul>
    </section>

    <section aria-labelledby="experience-heading">
      <h2 id="experience-heading">Experience</h2>
      {
        resume.experience.map((job) => (
          <article class="entry">
            <div class="entry-heading">
              <h3>{job.role}</h3>
              <p class="dates">
                <time datetime={job.start}>{formatYearMonth(job.start)}</time> –{' '}
                {job.end === 'present' ? (
                  'Present'
                ) : (
                  <time datetime={job.end}>{formatYearMonth(job.end)}</time>
                )}
              </p>
            </div>
            <p class="muted">{job.company}</p>
            {job.highlights.length > 0 && (
              <ul>
                {job.highlights.map((highlight) => (
                  <li>{highlight}</li>
                ))}
              </ul>
            )}
          </article>
        ))
      }
    </section>

    <section aria-labelledby="education-heading">
      <h2 id="education-heading">Education</h2>
      {
        resume.education.map((item) => (
          <article class="entry">
            <div class="entry-heading">
              <h3>{item.degree}</h3>
              <p class="dates">
                <time datetime={item.start}>{formatYearMonth(item.start)}</time> –{' '}
                <time datetime={item.end}>{formatYearMonth(item.end)}</time>
              </p>
            </div>
            <p class="muted">{item.school}</p>
          </article>
        ))
      }
    </section>

    {/* Hidden while the list is empty. */}
    {
      resume.certifications.length > 0 && (
        <section aria-labelledby="certifications-heading">
          <h2 id="certifications-heading">Certifications</h2>
          <ul>
            {resume.certifications.map((cert) => (
              <li>
                {cert.name}, {cert.issuer} (
                <time datetime={cert.issued}>{formatYearMonth(cert.issued)}</time>)
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section aria-labelledby="skills-heading">
      <h2 id="skills-heading">Skills</h2>
      {/* A description list: each group name (dt) with its skills (dd). */}
      <dl class="skills">
        {
          resume.skills.map((group) => (
            <div class="skill-group">
              <dt>{group.name}</dt>
              <dd>{group.skills.join(', ')}</dd>
            </div>
          ))
        }
      </dl>
    </section>
  </article>
</BaseLayout>

<style>
  .resume {
    max-width: 50rem;
  }

  .muted {
    color: var(--color-text-muted);
  }

  .resume-header .muted {
    margin-top: var(--space-1);
    font-size: var(--text-lg);
  }

  section {
    margin-top: var(--space-6);
  }

  h2 {
    padding-bottom: var(--space-1);
    border-bottom: 1px solid var(--color-border);
    font-size: var(--text-lg);
  }

  ul {
    padding-left: var(--space-4);
  }

  li + li {
    margin-top: var(--space-1);
  }

  .summary {
    margin-top: var(--space-3);
  }

  .entry {
    margin-top: var(--space-4);
  }

  /* Role on the left, dates on the right; dates wrap underneath on narrow screens. */
  .entry-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0 var(--space-3);
  }

  h3 {
    font-size: var(--text-base);
  }

  .dates {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    white-space: nowrap;
  }

  .entry ul {
    margin-top: var(--space-2);
  }

  .skills {
    margin-top: var(--space-3);
  }

  .skill-group + .skill-group {
    margin-top: var(--space-3);
  }

  dt {
    font-weight: 600;
  }

  dd {
    margin: 0;
    color: var(--color-text-muted);
  }

  .resume-actions {
    margin-top: var(--space-4);
  }

  /* Printed resume: no button, tighter spacing, and no entry split across two pages. */
  @media print {
    .resume {
      max-width: none;
    }

    .resume-actions {
      display: none;
    }

    section {
      margin-top: var(--space-4);
    }

    .entry,
    .skill-group {
      break-inside: avoid;
    }

    h2 {
      break-after: avoid;
    }
  }
</style>
