---
// Shown for any address that doesn't exist. Astro builds this into dist/404.html, and Cloudflare
// serves it with a 404 status (see "not_found_handling" in wrangler.jsonc).
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="The page you're looking for doesn't exist or has moved.">
  <h1>Page not found</h1>
  <p>The page you're looking for doesn't exist or has moved.</p>
  <p><a href="/">Go to the home page</a></p>
</BaseLayout>
