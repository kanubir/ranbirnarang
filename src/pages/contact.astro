---
// Contact page: a form that Formspree receives and emails to me. Cloudflare Turnstile checks that
// the sender is human (loaded on first use); a small script submits in the background, then opens
// my own thank-you page.
// This is the only page on the site that loads JavaScript (a deliberate exception, see build plan 4.1).
import BaseLayout from '../layouts/BaseLayout.astro';
import { CONTACT, SOCIALS } from '../config';
---

<BaseLayout
  title="Contact"
  description="Get in touch with Ranbir Singh Narang about cloud, AI, or backend engineering."
>
  <article class="prose">
    <h1>Contact</h1>
    <p>
      Have a project in mind, a question about cloud or AI, or just want to say hello? Send me a
      message and I'll get back to you.
    </p>

    <form class="contact-form" action={CONTACT.formEndpoint} method="POST">
      <p class="form-hint">All fields are required.</p>

      <div class="field">
        <label for="name">Name</label>
        <input id="name" name="name" type="text" autocomplete="name" maxlength="100" required />
      </div>

      <div class="field">
        {/* Formspree uses a field named "email" as the reply-to address. */}
        <label for="email">Email</label>
        <input id="email" name="email" type="email" autocomplete="email" maxlength="254" required />
      </div>

      <div class="field">
        <label for="message">Message</label>
        <textarea id="message" name="message" rows="6" maxlength="5000" required></textarea>
      </div>

      {/* Honeypot: hidden from people (and screen readers), but bots fill in every field.
          Formspree silently discards any submission where it has a value. */}
      <div class="honeypot" aria-hidden="true">
        <label for="_gotcha">Leave this field empty</label>
        <input id="_gotcha" name="_gotcha" type="text" tabindex="-1" autocomplete="off" />
      </div>

      {/* Subject line of the email Formspree sends me, so these are easy to spot. */}
      <input type="hidden" name="_subject" value="New message from your website" />

      {/* The human check appears here once someone starts filling in the form (see script below).
          It adds a hidden "cf-turnstile-response" token, which Formspree verifies with the secret
          key stored in Formspree's dashboard (never in this repo). */}
      <div class="turnstile" data-sitekey={CONTACT.turnstileSiteKey}></div>

      <button class="button button-primary" type="submit">Send message</button>

      {/* Announced by screen readers when the script updates it ("Sending…", errors). */}
      <p class="form-status" role="status" aria-live="polite"></p>
    </form>

    <noscript>
      <p class="form-hint">
        This form needs JavaScript for its spam check. You can also reach me through the links
        below.
      </p>
    </noscript>

    <p class="privacy-note">
      Your name, email, and message are sent to Formspree, which emails them to me. Cloudflare
      Turnstile checks that you're human. I only use your details to reply to you.
    </p>

    <p>
      You can also find me on{' '}
      {
        SOCIALS.map((social, index) => (
          <>
            {index > 0 && ' and '}
            <a href={social.href} target="_blank" rel="noopener">
              {social.label}
              <span class="visually-hidden"> (opens in a new tab)</span>
            </a>
          </>
        ))
      }.
    </p>
  </article>
</BaseLayout>

<script>
  // Sends the form in the background, then opens my own thank-you page.
  // Cloudflare Turnstile is downloaded only once someone starts filling in the form, so visitors
  // who just read this page never load it.

  type Turnstile = {
    render: (container: HTMLElement, options: { sitekey: string; theme: 'auto' }) => void;
    reset: () => void;
  };
  const getTurnstile = () => (window as Window & { turnstile?: Turnstile }).turnstile;

  const form = document.querySelector<HTMLFormElement>('.contact-form');
  const status = document.querySelector<HTMLElement>('.form-status');
  const button = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
  const widget = form?.querySelector<HTMLElement>('.turnstile');

  let turnstileRequested = false;

  // Downloads Cloudflare's script (first call only) and draws the human check into the form.
  function loadTurnstile() {
    if (turnstileRequested || !widget || !status) return;
    turnstileRequested = true;

    const script = document.createElement('script');
    script.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
    script.async = true;
    script.addEventListener('load', () => {
      getTurnstile()?.render(widget, { sitekey: widget.dataset.sitekey ?? '', theme: 'auto' });
    });
    script.addEventListener('error', () => {
      status.textContent =
        "The spam check couldn't load (a browser extension may be blocking it). You can reach me on GitHub or LinkedIn instead.";
    });
    document.head.append(script);
  }

  // First time focus enters any field (click, tap, or Tab), start loading the check.
  form?.addEventListener('focusin', loadTurnstile, { once: true });

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form || !status || !button) return;

    // The check may still be running (e.g. the browser autofilled the form and it was sent at once).
    loadTurnstile();
    if (!new FormData(form).get('cf-turnstile-response')) {
      status.textContent = 'Please wait a moment for the human check to finish, then send again.';
      return;
    }

    button.disabled = true;
    status.textContent = 'Sending…';

    try {
      const response = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' }, // ask Formspree for a JSON reply instead of its page
      });
      if (response.ok) {
        window.location.assign('/contact/thanks');
        return;
      }
      status.textContent =
        'Sorry, your message could not be sent. Please complete the human check and try again.';
    } catch {
      status.textContent = 'Sorry, there was a network problem. Please try again.';
    }

    button.disabled = false;
    // Turnstile tokens work once, so get a fresh one for the next attempt.
    getTurnstile()?.reset();
  });
</script>

<style>
  .contact-form {
    display: grid;
    gap: var(--space-4);
    max-width: 36rem;
    margin-top: var(--space-5);
  }

  .form-hint,
  .privacy-note {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .field {
    display: grid;
    gap: var(--space-1);
  }

  label {
    font-weight: 600;
  }

  /* Field borders use the muted text color: at least 6:1 contrast, well above the 3:1
     that WCAG requires for form controls (--color-border is only for decorative lines). */
  input,
  textarea {
    width: 100%;
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-text-muted);
    border-radius: var(--radius);
    background-color: var(--color-bg);
    color: var(--color-text);
  }

  textarea {
    resize: vertical;
  }

  /* Hidden with a class, not an inline style="", so the Phase 9 security policy can block inline styles. */
  .honeypot {
    display: none;
  }

  .contact-form button {
    justify-self: start;
  }

  .contact-form button:disabled {
    opacity: 0.6;
    cursor: progress;
  }

  .form-status:empty {
    display: none;
  }

  /* Same height as Turnstile's widget, reserved in advance so nothing jumps when it appears. */
  .turnstile {
    min-height: 65px;
  }
</style>
