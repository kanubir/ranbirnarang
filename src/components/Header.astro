---
// Site header: my name (links home) and the main navigation, built from NAV in src/config.ts.
import { SITE, NAV } from '../config';
import ThemeToggle from './ThemeToggle.astro';

// The current page's path without a trailing slash ("/about/" → "/about"), so it compares cleanly with NAV.
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

// A link is "current" on its own page and on pages under it (e.g. Blog stays active on /blog/my-post).
function isCurrent(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath === href || currentPath.startsWith(`${href}/`);
}
---

<header class="site-header">
  <div class="inner">
    <a class="brand" href="/">{SITE.name}</a>
    <nav aria-label="Main">
      <ul>
        {
          NAV.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="toggle-slot">
      <ThemeToggle />
    </div>
  </div>
</header>

<style>
  /* Phones: name + toggle on the first row, nav on its own row below.
     Wider screens: name | nav | toggle on one row. */
  .inner {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      'brand toggle'
      'nav nav';
    align-items: center;
    gap: var(--space-2) var(--space-4);
    max-width: var(--page-width);
    margin-inline: auto;
    padding: var(--space-3);
  }

  @media (min-width: 48rem) {
    .inner {
      grid-template-columns: auto 1fr auto;
      grid-template-areas: 'brand nav toggle';
    }

    nav {
      justify-self: end;
    }
  }

  .brand {
    grid-area: brand;
    color: var(--color-text);
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  nav {
    grid-area: nav;
  }

  .toggle-slot {
    grid-area: toggle;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    padding: 0;
    list-style: none;
  }

  /* Pill-shaped links. Padding keeps each tap target comfortably above WCAG's 24×24 px. */
  nav a {
    display: inline-block;
    padding: 0.4rem 0.85rem;
    border-radius: 999px;
    color: var(--color-text-muted);
    font-size: 0.95rem;
    text-decoration: none;
    transition:
      background-color 150ms ease,
      color 150ms ease;
  }

  nav a:hover {
    background-color: var(--color-bg-2);
    color: var(--color-text);
  }

  /* The current page: a filled pill plus bolder text (so it isn't shown by color alone). */
  nav a[aria-current='page'] {
    background-color: var(--color-bg-2);
    color: var(--color-text);
    font-weight: 600;
  }
</style>
