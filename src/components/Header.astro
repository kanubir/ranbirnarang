---
// Site header: my name (links home) and the main navigation, built from NAV in src/config.ts.
import { SITE, NAV } from '../config';

// The current page's path without a trailing slash ("/about/" → "/about"), so it compares cleanly with NAV.
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

// A link is "current" on its own page and on pages under it (e.g. Blog stays active on /blog/my-post).
function isCurrent(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath === href || currentPath.startsWith(`${href}/`);
}
---

<header class="site-header">
  <div class="inner">
    <a class="site-name" href="/">{SITE.name}</a>
    <nav aria-label="Main">
      <ul>
        {
          NAV.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-border);
  }

  /* Lines up with the page content; wraps the nav under the name on narrow screens. */
  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
    max-width: var(--page-width);
    margin-inline: auto;
    padding: var(--space-3);
  }

  .site-name {
    color: var(--color-text);
    font-weight: 700;
    text-decoration: none;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-2);
    padding: 0;
    list-style: none;
  }

  /* Padding gives each link a comfortable tap target (WCAG 2.2 asks for at least 24×24 px). */
  nav a {
    display: inline-block;
    padding: var(--space-1) var(--space-2);
    color: var(--color-text-muted);
    text-decoration: none;
    border-radius: var(--radius);
  }

  nav a:hover {
    color: var(--color-text);
    text-decoration: underline;
  }

  /* The current page: stronger color, weight, and an accent underline, not color alone. */
  nav a[aria-current='page'] {
    color: var(--color-text);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: 2px;
  }
</style>
