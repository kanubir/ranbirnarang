---
// Light/dark toggle button. Shown only when JavaScript runs (/theme-init.js sets data-theme on
// <html>); without JavaScript the site simply follows the OS setting.
---

<button class="theme-toggle" type="button" aria-label="Dark mode" aria-pressed="false">
  {/* Moon: shown in light mode (click for dark). Sun: shown in dark mode (click for light). */}
  <svg class="icon-moon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
  </svg>
  <svg class="icon-sun" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
    <circle cx="12" cy="12" r="4.5"></circle>
    <path
      d="M12 1.5v2.5M12 20v2.5M4.6 4.6l1.8 1.8M17.6 17.6l1.8 1.8M1.5 12H4M20 12h2.5M4.6 19.4l1.8-1.8M17.6 6.4l1.8-1.8"
    ></path>
  </svg>
</button>

<script>
  // aria-pressed="true" means dark mode is on; screen readers announce it as "Dark mode, pressed".
  const root = document.documentElement;
  const button = document.querySelector<HTMLButtonElement>('.theme-toggle');

  function readSaved() {
    try {
      return localStorage.getItem('theme');
    } catch {
      return null;
    }
  }

  function syncButton() {
    button?.setAttribute('aria-pressed', String(root.dataset.theme === 'dark'));
  }

  syncButton();

  button?.addEventListener('click', () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {
      // Storage blocked: the choice still applies on this page, it just isn't remembered.
    }
    syncButton();
  });

  // Until the visitor picks a theme themselves, keep following OS changes (e.g. auto dark at night).
  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (event) => {
    if (readSaved()) return;
    root.dataset.theme = event.matches ? 'dark' : 'light';
    syncButton();
  });
</script>

<style>
  /* Hidden until /theme-init.js has run, since the button needs JavaScript to work. */
  .theme-toggle {
    display: none;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: transparent;
    color: var(--color-text);
    cursor: pointer;
  }

  :global(:root[data-theme]) .theme-toggle {
    display: grid;
  }

  .theme-toggle:hover {
    background-color: var(--color-surface);
  }

  svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Show the icon for the theme a click would switch to. */
  :global(:root[data-theme='dark']) .icon-moon,
  :global(:root[data-theme='light']) .icon-sun {
    display: none;
  }
</style>
